# Wisp Light - flat, light Openbox theme for Wisp OS
# palette: bg #0d0f14  surface #f6f7fa  raised #e9ecf2  line #d3d7e2
#          text #1d2130  muted #5d6378  accent #3d6fe0  lavender #7a4fe0  red #ff7a90

border.width: 1
padding.width: 10
padding.height: 7
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
window.active.border.color: #d3d7e2
window.inactive.border.color: #d9dce5
window.active.client.color: #f6f7fa
window.inactive.client.color: #f6f7fa
window.label.text.justify: center

window.active.title.bg: flat solid
window.active.title.bg.color: #f6f7fa
window.active.title.separator.color: #f6f7fa
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #eceef3
window.inactive.title.separator.color: #eceef3

window.active.label.bg: parentrelative
window.active.label.text.color: #1d2130
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #8a90a3

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #5d6378
window.active.button.hover.bg: parentrelative
window.active.button.hover.image.color: #3d6fe0
window.active.button.pressed.bg: parentrelative
window.active.button.pressed.image.color: #7a4fe0
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #c3c7d2
window.active.button.toggled.bg: parentrelative
window.active.button.toggled.image.color: #3d6fe0
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #a3a8b8
window.inactive.button.hover.bg: parentrelative
window.inactive.button.hover.image.color: #5d6378
window.inactive.button.pressed.bg: parentrelative
window.inactive.button.pressed.image.color: #5d6378
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #d3d7e2
window.inactive.button.toggled.bg: parentrelative
window.inactive.button.toggled.image.color: #a3a8b8

window.active.handle.bg: flat solid
window.active.handle.bg.color: #f6f7fa
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #eceef3
window.active.grip.bg: flat solid
window.active.grip.bg.color: #f6f7fa
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #eceef3

menu.border.width: 1
menu.border.color: #d3d7e2
menu.overlap.x: 0
menu.overlap.y: 0
menu.separator.width: 1
menu.separator.padding.width: 10
menu.separator.padding.height: 4
menu.separator.color: #d3d7e2
menu.title.bg: flat solid
menu.title.bg.color: #f6f7fa
menu.title.text.color: #3d6fe0
menu.title.text.justify: left
menu.items.bg: flat solid
menu.items.bg.color: #f6f7fa
menu.items.text.color: #1d2130
menu.items.disabled.text.color: #8a90a3
menu.items.active.bg: flat solid
menu.items.active.bg.color: #dfe8ff
menu.items.active.text.color: #1d2130
menu.items.active.disabled.text.color: #8a90a3

osd.border.width: 1
osd.border.color: #d3d7e2
osd.bg: flat solid
osd.bg.color: #f6f7fa
osd.label.bg: flat solid
osd.label.bg.color: #f6f7fa
osd.label.text.color: #1d2130
osd.hilight.bg: flat solid
osd.hilight.bg.color: #3d6fe0
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #d3d7e2
osd.button.unpressed.bg: flat solid
osd.button.unpressed.bg.color: #e9ecf2
osd.button.unpressed.*.border.color: #d3d7e2
osd.button.pressed.bg: flat solid
osd.button.pressed.bg.color: #dfe8ff
osd.button.focused.bg: flat solid
osd.button.focused.bg.color: #dfe8ff
osd.button.focused.*.border.color: #3d6fe0
