# Wisp - flat, dark Openbox theme for Wisp OS
# palette: bg #0d0f14  surface #151821  raised #1d2130  line #2a3042
#          text #e6e9f2  muted #8b91a7  accent #8ab4ff  lavender #b48cff  red #ff7a90

border.width: 1
padding.width: 10
padding.height: 7
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
window.active.border.color: #2a3042
window.inactive.border.color: #1a1d28
window.active.client.color: #151821
window.inactive.client.color: #151821
window.label.text.justify: center

window.active.title.bg: flat solid
window.active.title.bg.color: #151821
window.active.title.separator.color: #151821
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #11131a
window.inactive.title.separator.color: #11131a

window.active.label.bg: parentrelative
window.active.label.text.color: #e6e9f2
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #5d6378

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #8b91a7
window.active.button.hover.bg: parentrelative
window.active.button.hover.image.color: #8ab4ff
window.active.button.pressed.bg: parentrelative
window.active.button.pressed.image.color: #b48cff
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #3a4056
window.active.button.toggled.bg: parentrelative
window.active.button.toggled.image.color: #8ab4ff
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #3f4558
window.inactive.button.hover.bg: parentrelative
window.inactive.button.hover.image.color: #8b91a7
window.inactive.button.pressed.bg: parentrelative
window.inactive.button.pressed.image.color: #8b91a7
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #2a3042
window.inactive.button.toggled.bg: parentrelative
window.inactive.button.toggled.image.color: #3f4558

window.active.handle.bg: flat solid
window.active.handle.bg.color: #151821
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #11131a
window.active.grip.bg: flat solid
window.active.grip.bg.color: #151821
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #11131a

menu.border.width: 1
menu.border.color: #2a3042
menu.overlap.x: 0
menu.overlap.y: 0
menu.separator.width: 1
menu.separator.padding.width: 10
menu.separator.padding.height: 4
menu.separator.color: #2a3042
menu.title.bg: flat solid
menu.title.bg.color: #151821
menu.title.text.color: #8ab4ff
menu.title.text.justify: left
menu.items.bg: flat solid
menu.items.bg.color: #151821
menu.items.text.color: #e6e9f2
menu.items.disabled.text.color: #5d6378
menu.items.active.bg: flat solid
menu.items.active.bg.color: #24304a
menu.items.active.text.color: #ffffff
menu.items.active.disabled.text.color: #5d6378

osd.border.width: 1
osd.border.color: #2a3042
osd.bg: flat solid
osd.bg.color: #151821
osd.label.bg: flat solid
osd.label.bg.color: #151821
osd.label.text.color: #e6e9f2
osd.hilight.bg: flat solid
osd.hilight.bg.color: #8ab4ff
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #2a3042
osd.button.unpressed.bg: flat solid
osd.button.unpressed.bg.color: #1d2130
osd.button.unpressed.*.border.color: #2a3042
osd.button.pressed.bg: flat solid
osd.button.pressed.bg.color: #24304a
osd.button.focused.bg: flat solid
osd.button.focused.bg.color: #24304a
osd.button.focused.*.border.color: #8ab4ff
