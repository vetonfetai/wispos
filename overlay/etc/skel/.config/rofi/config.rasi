configuration {
	modi: "drun,run,window";
	show-icons: true;
	icon-theme: "Papirus-Dark";
	font: "Inter 11";
	display-drun: "Apps";
	display-run: "Run";
	display-window: "Windows";
	drun-display-format: "{name}";
	matching: "fuzzy";
	sort: true;
	hover-select: true;
	me-select-entry: "";
	me-accept-entry: "MousePrimary";
}

* {
	bg: #121520f2;
	surface: #1d2130;
	line: #2a3042;
	fg: #e6e9f2;
	muted: #8b91a7;
	accent: #8ab4ff;
	background-color: transparent;
	text-color: @fg;
}

window {
	location: center;
	width: 600px;
	padding: 18px;
	border: 1px;
	border-color: @line;
	border-radius: 16px;
	background-color: @bg;
}
mainbox { spacing: 14px; border: 0; children: [ inputbar, listview ]; }
inputbar {
	padding: 12px 16px;
	spacing: 12px;
	border-radius: 12px;
	background-color: @surface;
	children: [ prompt, entry ];
}
prompt { text-color: @accent; font: "Inter Bold 11"; }
entry { placeholder: "Search…"; placeholder-color: @muted; cursor: text; }
listview { lines: 8; columns: 1; spacing: 4px; fixed-height: true; scrollbar: false; border: 0; }
element { padding: 9px 12px; spacing: 14px; border-radius: 10px; cursor: pointer; }
element normal.normal, element alternate.normal, element normal.active, element alternate.active { background-color: transparent; text-color: @fg; }
element selected.normal, element selected.active { background-color: #8ab4ff26; text-color: #ffffff; }
element-icon { size: 26px; cursor: inherit; }
element-text { vertical-align: 0.5; text-color: inherit; background-color: transparent; cursor: inherit; }
element-icon { background-color: transparent; }
message { padding: 8px; border-radius: 10px; background-color: @surface; }
textbox { text-color: @muted; }
